+                         and not re.search(r'(?:occurrence|ครั้งที่)\s*\d+\s*[:.)-]',line,re.I)]
+                if clauses:candidates.append((r,clauses))
+            if not candidates:continue
+            # One complete source clause per facet. No character slicing or
