+            hits.append({'id':rid+':text:'+label,'record_id':rid,'field':'text','title':title(parent,lang),'text':'\n'.join(clauses),'source_id':ref['source_id'],'snapshot_sha256':src['sha256'],'locator':ref['locator'],'source_url':src.get('public_url') or '', 'citation_label':label})
