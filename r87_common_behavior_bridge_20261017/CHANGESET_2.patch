+    if len(parents)!=1 or len(ids)!=1:return None
+    parent=parents[0];pid=parent['record_id']
+    if not effective(parent,at,records):return None
+    # Preserve requested whole-document coverage instead of applying a limit.
+    if re.search(r'ทั้งหมด|ทุกข้อ|ครบทุก|\b(?:all|entire|complete|every)\b',question,re.I):return None
