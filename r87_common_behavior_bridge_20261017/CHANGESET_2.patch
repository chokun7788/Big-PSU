+    usable=[r for r in children if r['fields']['text']['status']=='known' and r['fields']['text']['evidence_refs'] and isinstance(value(r,'text'),dict) and value(r,'text').get(lang)]
+    if not usable:return None
+    q=question.casefold();summary=bool(re.search(r'สรุป|ภาพรวม|สั้น|คร่าว|\b(?:summar\w*|overview|brief\w*)\b',q))
+    from .query_scope import derived_names
+    names=derived_names(snap['release']['names'],records)
+    chosen=[];method=None
