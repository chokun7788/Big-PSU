+        residue=str(base_plan.get('query_without_entity') or question).casefold()
+        for alias in sorted(names.get(pid,[])+names.get(value(parent,'game_id'),[]),key=len,reverse=True):residue=residue.replace(alias.casefold(),' ')
+        residue=re.sub(r'กฎ|กฏ|กติกา|การแข่งขัน|แข่งขัน|แข่ง|เรื่อง|การประท้วง|ประท้วง|ข้อพิพาท|และ|ว่าอย่างไร|อย่างไร|ยังไง|ต้อง|ยื่น|ภายใน|กี่นาที|ใคร|ได้|เมื่อไหร่|แล้ว|ครับ|ค่ะ|ขอ|หน่อย|\b(?:competition|tournament|rules?|rulebook|who|can|submit|file|a|the|protests?|objections?|disputes?|and|when|how|to|do|i|within|many|minutes|deadline|please)\b|[\s?!.,:]','',residue)
+        if residue:return None
