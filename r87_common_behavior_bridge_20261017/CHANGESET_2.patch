+            r,clauses=candidates[0];line=clauses[0]
+            chosen.append((r,[line],facet));emitted.add(line)
+            if len(chosen)>=6:break
+        if not chosen:return None
+        method='common_legacy_clause_overview'
+    elif not summary:
+        game=records.get(value(parent,'game_id'));aliases=[] if not game else [s.casefold() for values in game.get('aliases',{}).values() for s in values]
+        # The old detail vocabulary supplies query/source predicates only. It
