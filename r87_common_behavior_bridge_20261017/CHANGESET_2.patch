+            if linked not in usable:return None
+            chosen.append((linked,[text(value(linked,'text'),lang)],'other'));queue.append(linked);seen.add(dep)
+    hits=[];obs=[];lines=[];projection=[];selection=[]
+    caption=('สรุปกติกาบางประเด็นจากเอกสารที่มี' if lang=='th' else 'Selected rulebook clauses') if summary else ('ข้อกติกาตามประเด็นที่ถาม' if lang=='th' else 'Requested rulebook clause')
+    lines.extend([caption+' — '+text(value(parent,'event_name'),lang),''])
