+            aliases += [s for key in ['name','event_name','source_title'] for s in (value(record,key) or {}).values() if isinstance(s,str)]
+            for alias in sorted(aliases,key=len,reverse=True):residue=residue.replace(alias.casefold(),' ')
+        residue=re.sub(r'สรุป|ภาพรวม|กฎ|กฏ|กติกา|การแข่งขัน|แข่งขัน|แข่ง|สั้นๆ|สั้น|คร่าวๆ|คร่าว|ให้|ขอ|หน่อย|ครับ|ค่ะ|มีอะไรบ้าง|มีอะไรมั่ง|\b(?:summar\w*|overview|brief\w*|rules?|rulebook|competition|tournament|please|give|me|a|an|the|of|for|in|short)\b|[\s?!.,:ๆ]','',residue)
+        if residue:return None
+        emitted=set()
