+
+def live_request(q):
+    q=normalize(q)
+    # Thai has no mandatory word spaces: ระหว่าง contains the letters ว่าง,
+    # but asks "during/between", not availability. Preserve a separate ว่าง.
+    q=q.replace('ระหว่าง',' ')
