    {
      "key": "be1cc6beca62a040860ed4e754ff22d982534b1b8ae147fb90b552e903634dd5",
      "q": "server กับ client ต่างกันยังไง ไม่ต้องยาว",
      "a": "ยังระบุข้อมูลจากชุดที่ย้ายมาให้ตรงคำถามนี้ไม่ได้ครับ กรุณาระบุชื่อเกม อุปกรณ์ หรือหัวข้อที่ต้องการทราบเพิ่มอีกนิด"
    },
    {
      "key": "526a1f09da3f334fbff914bcb7eae7e4a3aac3eeea2ac84e2fca82105ccc7a45",
      "q": "เขียนประโยคประชาสัมพันธ์กิจกรรมแบบสุภาพหนึ่งประโยค ตอบแบบประโยคเดียว",
      "a": "**ข้อมูลที่เกี่ยวข้อง**\n• ข้อมูลที่ยืนยันได้: Mission ของศูนย์คือการยกระดับการศึกษาและความเป็นเลิศด้านอีสปอร์ต ผ่านสิ่งอำนวยความสะดวกและอุปกรณ์ที่ช่วยเสริมสร้างการเรียนรู้ให้กับนักเล่นเกม นักศึกษา และผู้สนใจ โดยศูนย์ก่อตั้งโดยมหาวิทยาลัยสงขลานครินทร์และดำเนินการโดยวิทยาลัยการคอมพิวเตอร์ [S1]"
    },
    {
      "key": "a5f1e7bc3b80d4a1973145f74dea1c4c89d2841777808e96b402b83ddb5bc8d2",
      "q": "แปลคำว่า reservation เป็นภาษาไทย อธิบายข้อดีข้อเสียสั้น ๆ",
      "a": "**ข้อมูลที่เกี่ยวข้อง**\n• ข้อมูลที่ยืนยันได้: ขั้นตอนการจองคือ เลือกบริการที่ต้องการ เลือกวันและเวลา กรอกข้อมูลผู้ใช้บริการ ตรวจสอบข้อมูล ชำระเงินโดยโอนเข้าบัญชีธนาคาร และแนบสลิปการโอนเงิน [S1]"
    },
    {
      "key": "4fc4b7f5244fb329778281ae4f59e5ac58daa61cdf58d9d2e278ba2077842f50",
      "q": "API คืออะไร ตอบแบบเด็กปีหนึ่งเข้าใจได้",
      "a": "ยังระบุข้อมูลจากชุดที่ย้ายมาให้ตรงคำถามนี้ไม่ได้ครับ กรุณาระบุชื่อเกม อุปกรณ์ หรือหัวข้อที่ต้องการทราบเพิ่มอีกนิด"
    },
    {
      "key": "6e9b4d11facd34eeb63c638f3e5a938b25b205c4eb764d4a81c0e0cd75bca4a5",
      "q": "เฟรมเรตกับความละเอียดต่างกันยังไง อธิบายข้อดีข้อเสียสั้น ๆ",
      "a": "ยังระบุข้อมูลจากชุดที่ย้ายมาให้ตรงคำถามนี้ไม่ได้ครับ กรุณาระบุชื่อเกม อุปกรณ์ หรือหัวข้อที่ต้องการทราบเพิ่มอีกนิด"
    },
    {
      "key": "c545e557b2beb66d453ee1fc2ee53c889d200ffa6051fa7af1d90c1a76ea65ef",
      "q": "อธิบายคำว่า latency ในระบบคอมพิวเตอร์แบบสั้น ๆ ให้คำจำกัดความแบบสั้น",
      "a": "ยังระบุข้อมูลจากชุดที่ย้ายมาให้ตรงคำถามนี้ไม่ได้ครับ กรุณาระบุชื่อเกม อุปกรณ์ หรือหัวข้อที่ต้องการทราบเพิ่มอีกนิด"
    },
