+   diff=[i for i,(x,y) in enumerate(zip(before,after)) if x!=y]
+   if len(diff)==2 and diff[1]==diff[0]+1 and before[diff[0]]==after[diff[1]] and before[diff[1]]==after[diff[0]]:continue
